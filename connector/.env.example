# Copia este fichero a `.env` (no se versiona) y rellena los valores.

# Proyecto Supabase (ref plgwbctxseuuujuepmfe)
SUPABASE_URL=https://plgwbctxseuuujuepmfe.supabase.co
# service_role key — NUNCA al repo ni al navegador. La pone Claude/Josema en el mini PC.
SUPABASE_SERVICE_ROLE=

# Opcionales (valores por defecto entre paréntesis)
# POLL_INTERVAL=300        # segundos entre pasadas del bucle (300 = 5 min)
# SYNC_DAYS=7              # cuántos días hacia atrás bajar en cada sincronización
# DAILY_HOURS=20           # horas mínimas entre sincronizaciones automáticas de una cuenta
# ERROR_BACKOFF_HOURS=6    # espera antes de reintentar una cuenta que falló (no bajar sin motivo:
#                          # reintentar sin freno hace que Garmin banee la IP con 429)
# SESSION_DIR=.sessions    # dónde cachear las sesiones de Garmin (tokens garth)
